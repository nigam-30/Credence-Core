# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly mark code & configuration text files
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.sh text eol=lf
*.mako text eol=lf
*.lock text eol=lf
*.cpp text eol=lf
*.h text eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.zip binary
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
