# ══════════════════════════════════════════════════════════════
# CREDENCE CORE — ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# Copy this file to .env and configure for your target environment.
# NEVER commit the active .env containing live secrets to Git!
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# CORE APPLICATION SETTINGS
# ──────────────────────────────────────────────────────────────
FLASK_ENV=production
# Generate a strong 64-char key using: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-cryptographic-random-key-in-production

# Server binding & exposed port
PORT=5000
GUNICORN_BIND=0.0.0.0:5000

# Concurrency & Worker tuning
WEB_CONCURRENCY=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000

# ──────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────
# Production: postgresql://<user>:<password>@<host>:5432/<dbname>
# Local SQLite fallback: sqlite:///bank_system.db
POSTGRES_DB=credence_bank
POSTGRES_USER=credence_admin
POSTGRES_PASSWORD=generate_a_complex_database_password_here
DATABASE_URL=postgresql://credence_admin:generate_a_complex_database_password_here@db:5432/credence_bank

# Redis Distributed Cache & Rate Limiting
REDIS_URL=redis://redis:6379/0

# ──────────────────────────────────────────────────────────────
# STORAGE & LOGGING DIRECTORIES
# ──────────────────────────────────────────────────────────────
DATA_DIR=/app/data
LOG_DIR=/app/logs
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────
# SECURITY & NETWORKING
# ──────────────────────────────────────────────────────────────
# Enforce HTTPS-only secure cookies (Must be true in production behind TLS)
SESSION_COOKIE_SECURE=true
CORS_TRUSTED_ORIGINS=https://credence.bank,https://app.credence.bank
# Dedicated 256-bit encryption key for MFA TOTP secrets (openssl rand -hex 32)
MFA_ENCRYPTION_KEY=change-me-to-a-dedicated-mfa-encryption-key-in-prod

# Configured demo accounts allowed for instant demo login (comma-separated account numbers)
# Leave empty in production to require full cryptographic authentication
CONFIGURED_DEMO_ACCOUNTS=
